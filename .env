# ============================================
#  BACKEND .env  (deeraj-backend)
# ============================================

# ---- Database (Railway MySQL) ----
# On RAILWAY: use the PRIVATE host below (fast, free, no public exposure).
#   Set these in the Railway BACKEND service > Variables tab.
DB_HOST=tramway.proxy.rlwy.net
DB_PORT=53767
DB_USER=root
DB_PASSWORD=OIYzyyIBmGfNaQvwujrqcErsPKGmBpKG
DB_NAME=deeraj_interiors

# For running the BACKEND LOCALLY against the Railway DB instead, use the
# PUBLIC proxy values (enable Public Networking on the MySQL service first):
# DB_HOST=tramway.proxy.rlwy.net
# DB_PORT=53767

# ---- Auth / Security ----
# Must match REACT_APP_API_KEY in the frontend exactly
API_KEY=deeraj-interiors-secret-2025
# Long random string — keep secret, never share
JWT_SECRET=ade7c6bf181337c7b9d3898790f5ce08c60c770a6c882cd2d2003bc63d3ab7e5

# ---- CORS: comma-separated, NO trailing slash ----
ALLOWED_ORIGINS=https://quatation-xqcu.onrender.com,http://localhost:3000

# ---- Email / nodemailer (Gmail app password, not your normal password) ----
EMAIL_USER=<your_email@gmail.com>
EMAIL_PASS=<gmail_app_password>
ADMIN_EMAIL=<email_to_receive_admin_alerts>

# ---- Admin login seed accounts (override the code defaults) ----
ADMIN_USER=admin
ADMIN_PASS=<choose_a_strong_password>
ADMIN_NAME=Administrator

# ---- Port ----
# Leave UNSET on Railway (Railway injects PORT automatically).
# For local dev only:
# PORT=5001